{
  "name": "flowchart.ts",
  "version": "4.0.0",
  "description": "A flowchart DSL and SVG renderer written in TypeScript",
  "keywords": [
    "diagram",
    "flowchart",
    "flowchart.js",
    "svg",
    "typescript"
  ],
  "homepage": "https://github.com/Mister-Hope/flowchart.ts",
  "bugs": {
    "url": "https://github.com/Mister-Hope/flowchart.ts/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/flowchart.ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/flowchart.d.ts",
      "default": "./dist/flowchart.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "deps:update": "ncu -u && pnpm install",
    "dev": "vite dev",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "2.0.1",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "happy-dom": "21.0.4",
    "npm-check-updates": "23.1.1",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
